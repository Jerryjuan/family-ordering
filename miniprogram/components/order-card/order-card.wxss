/* 订单卡片样式 */
.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 13px;
  color: #666;
}

.order-status {
  font-size: 12px;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-items {
  margin-bottom: 16rpx;
}

.order-items-text {
  font-size: 14px;
  color: #333;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-price {
  font-size: 18px;
  font-weight: bold;
  color: #FF6B35;
}

.order-time {
  font-size: 12px;
  color: #999;
}