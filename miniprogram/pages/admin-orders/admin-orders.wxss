/* 订单管理页样式 */
.page-admin-orders {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 状态 Tab */
.status-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 10rpx;
  height: 88rpx;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}

.tab-item.active {
  color: #FF6B35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 13px;
  color: #666;
}

.order-status {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.order-time {
  font-size: 12px;
  color: #999;
}

/* 订单内容 */
.order-body {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.customer-name {
  display: block;
  font-size: 15px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.order-items-summary {
  font-size: 13px;
  color: #666;
  line-height: 1.6;
}

.order-remark {
  margin-top: 10rpx;
  background-color: #FFF8E1;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

.remark-label {
  font-size: 12px;
  color: #F7931E;
  font-weight: bold;
}

.remark-text {
  font-size: 12px;
  color: #666;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.order-total {
  font-size: 18px;
  font-weight: bold;
  color: #FF6B35;
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 12px;
  font-weight: 500;
}

.btn-process {
  background-color: #1976D2;
  color: #fff;
}

.btn-complete {
  background-color: #07C160;
  color: #fff;
}

.btn-cancel {
  background-color: #fff;
  color: #EE0A24;
  border: 1rpx solid #EE0A24;
}

.btn-detail {
  background-color: #f5f5f5;
  color: #666;
}

.empty-icon-text {
  font-size: 48px;
}