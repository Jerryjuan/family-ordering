<!-- 购物车页 -->
<view class="page-cart">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartItems.length > 0}}">
    <view class="cart-header">
      <text class="cart-title">购物车</text>
      <text class="cart-clear" bindtap="onClearCart">清空</text>
    </view>

    <view class="cart-item" wx:for="{{cartItems}}" wx:key="dish_id">
      <view class="item-image-wrap">
        <image class="item-image" src="{{item.image || '/images/dishes/default.png'}}" mode="aspectFill" />
      </view>
      <view class="item-info">
        <text class="item-name">{{item.dish_name}}</text>
        <text class="item-price">¥{{item.price}}</text>
      </view>
      <view class="item-quantity">
        <view class="btn-minus" bindtap="onReduce" data-id="{{item.dish_id}}">-</view>
        <text class="quantity-text">{{item.quantity}}</text>
        <view class="btn-plus" bindtap="onAdd" data-id="{{item.dish_id}}" data-name="{{item.dish_name}}" data-price="{{item.price}}">+</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{cartItems.length === 0}}">
    <text class="empty-icon-text">🛒</text>
    <text class="empty-text">购物车空空如也</text>
    <view class="btn-go-order" bindtap="goToMenu">去点餐</view>
  </view>

  <!-- 底部结算栏 -->
  <view class="checkout-bar" wx:if="{{cartItems.length > 0}}">
    <view class="checkout-info">
      <text class="checkout-label">合计：</text>
      <text class="checkout-price">¥{{totalPrice}}</text>
    </view>
    <view class="checkout-btn" bindtap="onCheckout">
      去结算（{{totalCount}}件）
    </view>
  </view>
</view>