/* 数据统计页样式 */
.page-admin-stats {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-card {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 24px;
  font-weight: bold;
  color: #FF6B35;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 12px;
  color: #999;
}

/* 热门菜品列表 */
.popular-list {
  margin-top: 10rpx;
}

.popular-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.popular-item:last-child {
  border-bottom: none;
}

.popular-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  color: #fff;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.rank-1 {
  background-color: #FF6B35;
}

.rank-2 {
  background-color: #F7931E;
}

.rank-3 {
  background-color: #FFB74D;
}

.rank-other {
  background-color: #ddd;
  color: #999;
}

.popular-info {
  flex: 1;
}

.popular-name {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.popular-bar-wrap {
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.popular-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #F7931E 100%);
  border-radius: 4rpx;
}

.popular-stats {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.popular-quantity {
  display: block;
  font-size: 14px;
  font-weight: bold;
  color: #333;
}

.popular-revenue {
  display: block;
  font-size: 12px;
  color: #FF6B35;
  margin-top: 4rpx;
}

.empty-state {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 14px;
}

/* 趋势图 */
.trend-chart {
  margin-top: 10rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 240rpx;
  padding: 0 10rpx;
  margin-bottom: 16rpx;
}

.chart-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-wrap {
  width: 40rpx;
  height: 200rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar {
  width: 100%;
  background: linear-gradient(180deg, #FF6B35 0%, #F7931E 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.bar-label {
  font-size: 11px;
  color: #999;
  margin-top: 8rpx;
}

/* 图例 */
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.legend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.legend-label {
  font-size: 12px;
  color: #999;
}

.legend-value {
  font-size: 18px;
  font-weight: bold;
  color: #FF6B35;
  margin-top: 4rpx;
}