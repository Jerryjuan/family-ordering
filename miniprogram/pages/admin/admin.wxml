<!-- 管理端入口 -->
<view class="page-admin">
  <!-- 欢迎区域 -->
  <view class="admin-header">
    <text class="admin-title">👨‍🍳 厨房管理</text>
    <text class="admin-desc">管理菜品、处理订单、查看统计</text>
  </view>

  <!-- 快捷统计 -->
  <view class="quick-stats">
    <view class="stat-item">
      <text class="stat-value">{{pendingCount}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{processingCount}}</text>
      <text class="stat-label">制作中</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{dishCount}}</text>
      <text class="stat-label">菜品数</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="admin-menu">
    <view class="menu-item" bindtap="goToDishes">
      <view class="menu-icon-wrap" style="background-color: #FFF3E0;">
        <text class="menu-icon">🍽️</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">菜品管理</text>
        <text class="menu-desc">添加、编辑、上下架菜品</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToOrders">
      <view class="menu-icon-wrap" style="background-color: #E3F2FD;">
        <text class="menu-icon">📋</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">订单管理</text>
        <text class="menu-desc">查看和处理订单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToStats">
      <view class="menu-icon-wrap" style="background-color: #E8F5E9;">
        <text class="menu-icon">📊</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">数据统计</text>
        <text class="menu-desc">营业额、热门菜品、趋势</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>