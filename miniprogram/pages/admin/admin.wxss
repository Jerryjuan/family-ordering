/* 管理端入口样式 */
.page-admin {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 头部 */
.admin-header {
  background: linear-gradient(135deg, #333333 0%, #555555 100%);
  padding: 40rpx 30rpx 50rpx;
  color: #fff;
}

.admin-title {
  display: block;
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.admin-desc {
  font-size: 13px;
  opacity: 0.8;
}

/* 快捷统计 */
.quick-stats {
  display: flex;
  background-color: #fff;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 28px;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 8rpx;
}

/* 功能菜单 */
.admin-menu {
  padding: 0 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 28px;
}

.menu-info {
  flex: 1;
  margin-left: 20rpx;
}

.menu-title {
  display: block;
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.menu-desc {
  display: block;
  font-size: 12px;
  color: #999;
}

.menu-arrow {
  font-size: 24px;
  color: #ccc;
  margin-left: 10rpx;
}