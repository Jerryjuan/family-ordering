<!-- 菜品管理页 -->
<view class="page-admin-dishes">
  <!-- 分类筛选 -->
  <scroll-view class="category-tabs" scroll-x enable-flex>
    <view
      class="tab-item {{currentCategory === 0 ? 'active' : ''}}"
      bindtap="onCategoryChange"
      data-id="0">
      全部
    </view>
    <view
      class="tab-item {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bindtap="onCategoryChange"
      data-id="{{item.id}}">
      {{item.icon}} {{item.name}}
    </view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
      <view class="dish-main">
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-category">{{item.category_icon}} {{item.category_name}}</text>
        </view>
        <text class="dish-price">¥{{item.price}}</text>
      </view>
      <view class="dish-actions">
        <view class="btn-status {{item.status === 1 ? 'online' : 'offline'}}" bindtap="onToggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">
          {{item.status === 1 ? '上架中' : '已下架'}}
        </view>
        <view class="btn-edit" bindtap="onEdit" data-item="{{item}}">编辑</view>
        <view class="btn-delete" bindtap="onDelete" data-id="{{item.id}}" data-name="{{item.name}}">删除</view>
      </view>
    </view>

    <view wx:if="{{dishes.length === 0}}" class="empty-container">
      <text class="empty-icon-text">🍽️</text>
      <text class="empty-text">暂无菜品</text>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="fab-btn" bindtap="onAdd">+</view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal"></view>
  <view class="modal-content" wx:if="{{showModal}}">
    <view class="modal-title">{{isEdit ? '编辑菜品' : '添加菜品'}}</view>

    <view class="form-group">
      <text class="form-label">菜品名称 *</text>
      <input class="form-input" placeholder="请输入菜品名称" value="{{formData.name}}" bindinput="onFormName" />
    </view>

    <view class="form-group">
      <text class="form-label">所属分类</text>
      <picker class="form-picker" bindchange="onFormCategory" value="{{categoryIndex}}" range="{{categories}}" range-key="name">
        <text class="picker-text">{{categories[categoryIndex].name || '请选择分类'}}</text>
        <text class="picker-arrow">›</text>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">价格 *</text>
      <input class="form-input" type="digit" placeholder="请输入价格" value="{{formData.price}}" bindinput="onFormPrice" />
    </view>

    <view class="form-group">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" placeholder="请输入描述" value="{{formData.description}}" bindinput="onFormDesc" maxlength="200" />
    </view>

    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="onCloseModal">取消</view>
      <view class="modal-btn confirm" bindtap="onSave">保存</view>
    </view>
  </view>
</view>