/* 菜品管理页样式 */
.page-admin-dishes {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 分类 Tab */
.category-tabs {
  white-space: nowrap;
  background-color: #fff;
  padding: 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  display: inline-block;
  padding: 0 24rpx;
  font-size: 14px;
  color: #666;
  position: relative;
  height: 88rpx;
  line-height: 88rpx;
}

.tab-item.active {
  color: #FF6B35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx;
}

.dish-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.dish-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dish-info {
  flex: 1;
}

.dish-name {
  display: block;
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.dish-category {
  font-size: 12px;
  color: #999;
}

.dish-price {
  font-size: 18px;
  font-weight: bold;
  color: #FF6B35;
}

.dish-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 12px;
}

.btn-status.online {
  background-color: #E8F5E9;
  color: #07C160;
}

.btn-status.offline {
  background-color: #FFEBEE;
  color: #EE0A24;
}

.btn-edit {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 12px;
  background-color: #E3F2FD;
  color: #1976D2;
}

.btn-delete {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 12px;
  background-color: #FFEBEE;
  color: #EE0A24;
}

.empty-icon-text {
  font-size: 48px;
}

/* 浮动添加按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #fff;
  font-size: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 50;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 14px;
}

.form-textarea {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 14px;
  width: 100%;
  min-height: 100rpx;
  box-sizing: border-box;
}

.form-picker {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-text {
  font-size: 14px;
  color: #333;
}

.picker-arrow {
  color: #ccc;
  font-size: 18px;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
  font-size: 15px;
  font-weight: bold;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background-color: #FF6B35;
  color: #fff;
}