/* 下单页样式 */
.page-order {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 订单商品 */
.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.item-name {
  font-size: 14px;
  color: #333;
  flex: 1;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-quantity {
  font-size: 13px;
  color: #999;
  margin-right: 20rpx;
}

.item-price {
  font-size: 14px;
  color: #FF6B35;
  font-weight: 500;
  min-width: 80rpx;
  text-align: right;
}

.order-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.total-label {
  font-size: 13px;
  color: #999;
}

.total-price {
  font-size: 16px;
  color: #FF6B35;
  font-weight: bold;
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 14px;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 14px;
}

.form-textarea {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 14px;
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 44rpx;
  font-size: 16px;
  font-weight: bold;
}

.submit-btn:active {
  opacity: 0.9;
}