/* 首页样式 */
.page-index {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 店铺头部 */
.shop-header {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  padding: 30rpx 30rpx 40rpx;
  color: #fff;
}

.shop-name {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.shop-slogan {
  font-size: 13px;
  opacity: 0.9;
}

/* 分类 Tab */
.category-tabs {
  white-space: nowrap;
  background-color: #fff;
  padding: 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  display: inline-block;
  padding: 0 24rpx;
  font-size: 14px;
  color: #666;
  position: relative;
  height: 88rpx;
  line-height: 88rpx;
}

.tab-item.active {
  color: #FF6B35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  padding: 0 20rpx;
  padding-bottom: 120rpx;
}

.empty-icon-text {
  font-size: 48px;
  margin-bottom: 16rpx;
}